# The shape of a release environment. Copy it somewhere outside this repository, fill in the real
# values, and source it before building:
#
#   cp .env.release.example ~/.somul/release.env
#   chmod 600 ~/.somul/release.env
#   source ~/.somul/release.env
#   npm run tauri build -- --target universal-apple-darwin
#
# Outside the repository on purpose. .gitignore covers .env, .env.local and .env.*.local, so a
# filled-in copy left in the tree under any other name is one `git add -A` from being published,
# and GitHub is scraped for secrets within seconds.

# --- Gatekeeper ---------------------------------------------------------------------------------
# The Developer ID Application certificate, imported once into the login keychain. Copy the name
# exactly as `security find-identity -v -p codesigning` prints it.
#
# APPLE_CERTIFICATE and APPLE_CERTIFICATE_PASSWORD are for CI, which has no keychain to read from.
# A local build needs the identity name alone.
export APPLE_SIGNING_IDENTITY="Developer ID Application: YOUR NAME (TEAMID)"

# --- Notarization -------------------------------------------------------------------------------
# An App Store Connect API key rather than an Apple ID and app-specific password: the issuer and
# key id are identifiers, not credentials, and the private key stays a chmod 600 file that can be
# revoked on its own. An app-specific password would have to sit in this file in plaintext.
#
# Create it under App Store Connect -> Users and Access -> Integrations -> Team Keys, with
# Developer access. The .p8 downloads once and never again.
export APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"
export APPLE_API_KEY="XXXXXXXXXX"
export APPLE_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"

# --- Updater signature --------------------------------------------------------------------------
# Read at build time, never stored here. The key file lives outside the tree and its password in
# the login keychain, which keeps this file safe to read over someone's shoulder.
#
# The public half is committed in tauri.conf.json. An artifact signed by anything else is refused
# by every installed copy, which is the entire point of the mechanism.
export TAURI_SIGNING_PRIVATE_KEY="$(cat "$HOME/.tauri/somul-v2.key")"
export TAURI_SIGNING_PRIVATE_KEY_PASSWORD="$(security find-generic-password -w -s somul-updater)"
